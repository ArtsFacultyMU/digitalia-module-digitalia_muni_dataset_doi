/**
 * Returns array representation of agent with name, nameType and identifier fields filled
 *
 * @param ContentEntityBase $agent
 *
 * @return array
 */
function get_datacite_agents_array($agent)
{
	$result = [];

	$agent_type = trim((string) $agent->get("agent_type")->getString());
	$name = trim((string) $agent->get("name")->getString());
	$first_name = trim((string) $agent->get("first_names")->getString());
	$last_name = trim((string) $agent->get("last_names")->getString());
	$orcid = trim((string) $agent->get("orcid")->getString());
	$ror = trim((string) $agent->get("ror")->getString());
	$institution_affiliation = trim((string) $agent->get("institution_affiliation")->getString());

	if ($agent_type === "person") {
    $result["givenName"] = $first_name;
		$result["familyName"] = $last_name;

		if ($first_name && $last_name) {
			$result["name"] = "{$last_name}, {$first_name}";
      $result["nameType"] = "Personal";
		} else {
			$result["name"] = trim("{$first_name} {$last_name}");
      $result["nameType"] = "Organizational";
		}

    if ($orcid !== "") {
      $result["nameIdentifiers"][] = [
        "schemeUri" => "https://orcid.org",
        "nameIdentifier" => $orcid,
        "nameIdentifierScheme" => "ORCID",
      ];
    }

    if ($institution_affiliation !== "" || $ror !== "") {
      $affiliation = [];
      if ($institution_affiliation !== "") {
        $affiliation["name"] = $institution_affiliation;
      }
      if ($ror !== "") {
        $affiliation["affiliationIdentifier"] = $ror;
        $affiliation["affiliationIdentifierScheme"] = "ROR";
        $affiliation["schemeUri"] = "https://ror.org/";
      }

      if (!empty($affiliation)) {
        $result["affiliation"] = [$affiliation];
      }
    }
	} else {
		$result["name"] = "Organizational";
		$result["name"] = $name;
    if ($ror !== "") {
      $result["nameIdentifiers"][] = [
        "schemeUri" => "https://ror.org/",
        "nameIdentifier" => $ror,
        "nameIdentifierScheme" => "ROR",
      ];
    }
	}
	return $result;
}


/**
 * Returns array with description. All tags are removed.
 *
 * Taking entity as reference can be considered questionable
 *
 * @param ContentEntityBase $entity
 *
 * @return array
 */
function get_output_descriptions(&$entity)
{
	$descriptions = array();
	$abstract = $entity->get("field_abstract")->getValue();
	$methods = $entity->get("field_methods")->getValue();
	$series_information = $entity->get("field_series_information")->getValue();
	$table_of_contents = $entity->get("field_table_of_contents")->getValue();
	$technical_info = $entity->get("field_technical_info")->getValue();

	if (!empty($abstract)) {
		array_push($descriptions, [
			"description" => Xss::filter($abstract[0]["value"]),
			"descriptionType" => "Abstract",
		]);
	}

	if (!empty($methods)) {
		array_push($descriptions, [
			"description" => Xss::filter($methods[0]["value"]),
			"descriptionType" => "Methods",
		]);
	}

	if (!empty($series_information)) {
		array_push($descriptions, [
			"description" => Xss::filter($series_information[0]["value"]),
			"descriptionType" => "SeriesInformation",
		]);
	}

	if (!empty($table_of_contents)) {
		array_push($descriptions, [
			"description" => Xss::filter($table_of_contents[0]["value"]),
			"descriptionType" => "TableOfContents",
		]);
	}

	if (!empty($abstract)) {
		array_push($descriptions, [
			"description" => Xss::filter($technical_info[0]["value"]),
			"descriptionType" => "TechnicalInfo",
		]);
	}

	return $descriptions;
}
