<?php

use Drupal\Component\Utility\Xss;

/**
 * @file
 * Primary module hooks for Digitalia muni dataset doi generator.
 */

/*
 * Implements hook_doi_datacite_json_alter().
 *
 * @param object $entity
 *   The node.
 * @param mixed $extra
 *   The node edit form state or data from the Views Bulk Operations action.
 * @param string $datacite_json
 *   The DataCite JSON. See https://support.datacite.org/docs/api-create-dois
 *   for more information.
 */
function digitalia_muni_dataset_doi_doi_datacite_json_alter($entity, $extra, &$datacite_json)
{
	$obj = json_decode($datacite_json, true);
	$config = \Drupal::config("digitalia_muni_dataset_doi.settings");

	// Parse creators.
	$creators = $entity->get("field_creator");
  $out_creators = [];

	if (!empty($creators)) {
		foreach ($creators as $delta => $creator_item) {
			$out_creator = get_datacite_agents_array($creator_item);
			if (!empty($out_creator)) {
				$out_creators[] = $out_creator;
			} else {
        \Drupal::logger("dataset_doi_datacite")->error("Creator could not be converted to DataCite format.");
      }
    }
	}
    
  if (!empty($out_creators)) {
    $obj["data"]["attributes"]["creators"] = $out_creators;
  } else {
			\Drupal::logger("dataset_doi_datacite")->error("There must be at least one creator.");
	}

	// Parse contributors
  $contributors = $entity->get("field_contributor");
  $out_contributors = [];
	if (!empty($contributors)) {
		foreach ($contributors as $delta => $contributor_item) {
			$out_contributor = get_datacite_agents_array($contributor_item);
			if (!empty($out_contributor)) {
        $out_contributor["contributorType"] = $contributor_item->get("role")->getString();
				$out_contributors[] = $out_contributor;
			} else {
        \Drupal::logger("dataset_doi_datacite")->error("Contributor could not be converted to DataCite format.");
      }
		}
	}

  if (!empty($out_contributors)) {
    $obj["data"]["attributes"]["contributors"] = $out_contributors;
  }

	// Publishers
  $publisher = $entity->get("field_publisher_dm")[0];
  $publisher_name = $publisher->get("name")->getString();
  $publisher_ror = $publisher->get("ror")->getString();

  if (empty($publisher_name) || empty($publisher_ror)) {
    \Drupal::logger("dataset_doi_datacite")->error("Dataset publisher name is empty.");

  }

  $obj["data"]["attributes"]["publisher"] = [
        "name" => $publisher_name,
        "schemeUri" => "https://ror.org/",
        "nameIdentifier" => $publisher_ror,
        "nameIdentifierScheme" => "ROR",
      ];

  // License
  if (!$entity->get("field_license")->isEmpty()) {
    $license_term = $entity->get("field_license")->entity;
    if ($license_term) {
      $rights = [
        "rights" => $license_term->label(),
      ];

      if (!$license_term->get("field_external_uri")->isEmpty()) {
        $rights["rightsUri"] = $license_term->get("field_external_uri")->uri;
      }

      $obj["data"]["attributes"]["rightsList"][] = $rights;
    }
  }

	$descriptions = get_output_descriptions($entity);

  // Metasys uses platform homepage as landing page
	$data_service = $entity->get("field_data_service")->getValue();
	$data_service_is_url = $config->get("data_service_is_url");

	// publicationYear
	$publication_year = $entity->get("field_publication_year")->getValue()[0]["value"];
  $obj["data"]["attributes"]["publicationYear"] = $publication_year;

	// resourceTypeGeneral
	// We have to get title of different taxonomy with specified authority source iri
  // this needs to be united across platforms - Metasys:
  /* 	
  $coar_resource_type_id = $entity->get("field_resource_type")->getValue()[0]["target_id"];
	$coar_resource_type = \Drupal::entityTypeManager()->getStorage("taxonomy_term")->load($coar_resource_type_id);

	$authority_links = $coar_resource_type->get("field_authority_link")->getValue();
	$datacite_iri = null;

	foreach ($authority_links as $authority_link) {
		if ($authority_link["source"] == "datacite") {
			$datacite_iri = $authority_link["uri"];
			break;
		}
	}

	$datacite_resource_type = "Other";

	if (!is_null($datacite_iri)) {
		$datacite_resource_type_list = \Drupal::entityTypeManager()->getStorage("taxonomy_term")->loadByProperties([
			"field_authority_link" => ["uri" => $datacite_iri],
			"vid" => "resource_types_datacite"
		]);

		if (!empty($datacite_resource_type_list)) {
			$datacite_resource_type = $datacite_resource_type_list[array_keys($datacite_resource_type_list)[0]]->label();
		}
	}
  */
  //$coar_resource_type = $entity->get("field_resource_type")->getValue()[0]["value"];
  //if (!empty($coar_resource_type)) {
  //  $obj["data"]["attributes"]["resourceType"] = $coar_resource_type;
  //}
  $datacite_resource_type = "Dataset";
  $obj["data"]["attributes"]["types"]["resourceTypeGeneral"] = $datacite_resource_type;
  
  // TODO Related Resources
  /*
  $related_resources = $entity->get("field_related_resource"); // links to entity digitalia_muni_entity_types of type resource

    "relatedIdentifiers": [
    {
      "schemeUri": null,
      "schemeType": null,
      "relationType": "IsDescribedBy", // field_resource_relation_type
      "relatedIdentifier": "10.48550/ARXIV.2402.13343", // field_identifier
      "resourceTypeGeneral": "JournalArticle", // field_resource_type
      "relatedIdentifierType": "DOI", // must be added to MM
      "relatedMetadataScheme": null,
      "relationTypeInformation": null
    }
  ],

  $obj["data"]["attributes"]["relatedIdentifiers"] = [];
  */

  // skip for ArchaeoVault
  /*
	if ($data_service_is_url && !empty($data_service)) {
		$obj["data"]["attributes"]["url"] = $data_service[0]["uri"];
	}
  */

	if (!empty($descriptions)) {
		$obj["data"]["attributes"]["descriptions"] = $descriptions;
	}

	// useless until update action is implemented
	if (!empty($entity->get("field_doi")->getValue())) {
		unset($obj["data"]["attributes"]["event"]);
		unset($obj["data"]["id"]);
	}

	// Temporary debug stop: log the payload and prevent sending anything to DataCite.
  /*
	error_log('digitalia_muni_dataset_doi payload: ' . json_encode($obj, JSON_PRETTY_PRINT));
	\Drupal::logger('dataset_doi_datacite')->notice('DataCite payload for testing: @payload', [
		'@payload' => json_encode($obj, JSON_PRETTY_PRINT),
	]);
  exit;
  */
  $datacite_json = json_encode($obj);
}

